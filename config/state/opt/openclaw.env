# Openclaw Environment Configuration
#
# After making changes to this file, restart Openclaw with:
#   systemctl restart openclaw

# Installed Openclaw version
OPENCLAW_VERSION=2026.6.9

# Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=localhost

OPENCLAW_NO_RESPAWN=1
OPENCLAW_SERVICE_REPAIR_POLICY=external
OPENCLAW_SERVICE_KIND=gateway

NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache

# Model Configuration
# Run the interactive setup script to configure a provider:
#   sudo /etc/setup_wizard.sh
# This lets you choose between Anthropic, OpenAI, or GradientAI.
#
# Or uncomment and configure your preferred AI model provider:
# For Anthropic Claude (recommended):
# ANTHROPIC_API_KEY=your_api_key_here

# For OpenAI:
# OPENAI_API_KEY=your_api_key_here

# Channel Configuration
# Uncomment and configure messaging channels as needed

# Telegram Bot Token
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# Discord Bot Token
# DISCORD_BOT_TOKEN=your_bot_token_here

# Slack Bot Token and App Token
# SLACK_BOT_TOKEN=your_bot_token_here
# SLACK_APP_TOKEN=your_app_token_here

# OpenClaw gateway

# Telegram
TELEGRAM_BOT_TOKEN=REDACTED

# Anthropic
ANTHROPIC_ADMIN_KEY=REDACTED

# Himalaya E-mail
HIMALAYA_PASSWORD=REDACTED

# Unsplash Images
UNSPLASH_API_KEY=REDACTED

# Google
# Google Cloud (Gemini API)
GOOGLE_BILLING_SERVICE_ACCOUNT_KEY=/opt/sls-billing-reader.json
# Gemini API
GEMINI_API_KEY=REDACTED

# GitHub
GITHUB_TOKEN=REDACTED

# Digital Ocean
DIGITALOCEAN_TOKEN=REDACTED


{
	"folders": [
		{ "name": "sls-root", "path": "." },
		// { "name": "sls-config", "path": "projects/sls-config" },
		// { "name": "sls-dev", "path": "projects/sls-dev" },
		// { "name": "sls-web-server", "path": "projects/sls-web-server" },
		// { "name": "sls-ada-workspace", "path": "workspace" }
	],
	"settings": {
		"git.repositoryScanMaxDepth": 2,
		"scm.countBadge": "all",
		"workbench.colorCustomizations": {

		"titleBar.activeBackground": "#055579"
		},
		"json.schemas": [
			{
				"fileMatch": ["/home/openclaw/.openclaw/openclaw.json"],
				"url": "file:///home/openclaw/.openclaw/projects/sls-config/config/schemas/openclaw.schema.json"
			},
			{
				"fileMatch": ["/home/openclaw/.openclaw/workspace/.agents/skills/sls-daily-brief/config.json"],
				"url": "file:///home/openclaw/.openclaw/workspace/.agents/skills/sls-daily-brief/config.schema.json"
			},
			{
				"fileMatch": ["/home/openclaw/.openclaw/workspace/.agents/skills/sls-openclaw-system/config.json"],
				"url": "file:///home/openclaw/.openclaw/workspace/.agents/skills/sls-openclaw-system/config.schema.json"
			},
			{
				"fileMatch": ["/home/openclaw/.openclaw/workspace/.agents/skills/sls-openclaw-usage/config.json"],
				"url": "file:///home/openclaw/.openclaw/workspace/.agents/skills/sls-openclaw-usage/config.schema.json"
			},
			{
				"fileMatch": ["/home/openclaw/.openclaw/workspace/.agents/skills/sls-calendar/config.json"],
				"url": "file:///home/openclaw/.openclaw/workspace/.agents/skills/sls-calendar/config.schema.json"
			},
			{
				"fileMatch": ["/home/openclaw/.openclaw/workspace/.agents/skills/sls-costs/config.json"],
				"url": "file:///home/openclaw/.openclaw/workspace/.agents/skills/sls-costs/config.schema.json"
			},
			{
				"fileMatch": ["/home/openclaw/.openclaw/workspace/working/sls-costs/*.json"],
				"url": "file:///home/openclaw/.openclaw/workspace/.agents/skills/sls-costs/costs-artifact.schema.json"
			}
		],
		"files.watcherExclude": {
			"**/node_modules/**": true,
			"**/build/**": true,
			"**/dist/**": true,
			"**/.git/**": true,
			"homebrew/**": true,
			"workspace/npm/**": true
		},
		"files.exclude": {
			"**/*.clobbered.*": true,
			"**/*.bak.*": true,
			"**/.env": true,
			"**/secrets": true,
			"workspace/npm/**": true,
			"homebrew/**": true
		},
		"search.exclude": {
			"**/.env": true,
			"**/node_modules": true,
			"homebrew": true,
			"workspace/npm": true
		},
		"python.analysis.exclude": [
			"workspace/working/**",
			"workspace/public/**",
			"workspace/npm/**",
			"**/node_modules/**"
		],
		"livePreview.portNumber": 3900,
		"favorites.resources": [
			{
				"filePath": "/home/openclaw/.openclaw/projects",
				"group": "Default"
			},
			{
				"filePath": "/home/openclaw/.openclaw/workspace/.agents",
				"group": "Default"
			},
			{
				"filePath": "/home/openclaw/.openclaw/cron",
				"group": "Default"
			},
			{
				"filePath": "/home/openclaw/.openclaw/workspace/working",
				"group": "Default"
			}
		],
		"chat.tools.terminal.autoApprove": {
			"journalctl": true,
			"/^cd /home/openclaw/\\.openclaw/projects/sls-web-server && node --check server\\.js$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^node --check /home/openclaw/\\.openclaw/projects/sls-web-server/server\\.js$/": {
				"approve": true,
				"matchCommandLine": true
			}
		}
	}
}